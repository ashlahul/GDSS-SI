generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum RoleType {
  ADMIN
  KETUA
  WAKIL_KETUA
  SEKRETARIS
  BENDAHARA
  ANGGOTA
}

model DecisionMaker {
  id               String            @id
  name             String
  nim              String            @default("")
  email            String            @unique
  password         String
  role             RoleType
  roleLabel        String
  isHighestRole    Boolean           @default(false)
  isActive         Boolean           @default(true)
  avatarColor      String
  votes            Vote[]
  consensusRecords ConsensusRecord[]
}

model ProgramKerja {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  divisi           String
  description      String
  anggaran         Int
  targetPeserta    String
  createdAt        DateTime          @default(now())
  votes            Vote[]
  consensusDetails ConsensusDetail[]
}

model Vote {
  id              String        @id @default(cuid())
  decisionMakerId String
  prokerId        String
  c1Score         Int           @default(3)
  c2Score         Int           @default(3)
  c3Score         Int           @default(3)
  c4Score         Int           @default(3)
  topsisScore     Float         @default(0)
  rank            Int
  bordaPoints     Int
  submittedAt     DateTime      @default(now())
  decisionMaker   DecisionMaker @relation(fields: [decisionMakerId], references: [id], onDelete: Cascade)
  proker          ProgramKerja  @relation(fields: [prokerId], references: [id], onDelete: Cascade)

  @@unique([decisionMakerId, prokerId])
}

model ConsensusRecord {
  id               String            @id @default(cuid())
  calculatedAt     DateTime          @default(now())
  authorizedById   String
  authorizedByName String
  authorizedBy     DecisionMaker     @relation(fields: [authorizedById], references: [id])
  details          ConsensusDetail[]
}

model ConsensusDetail {
  id                   String          @id @default(cuid())
  consensusId          String
  prokerId             String
  ketuaRank            Int
  ketuaPoints          Int
  ketuaTopsis          Float           @default(0)
  wakilRank            Int             @default(0)
  wakilPoints          Int             @default(0)
  wakilTopsis          Float           @default(0)
  sekretarisRank       Int
  sekretarisPoints     Int
  sekretarisTopsis     Float           @default(0)
  bendaharaRank        Int
  bendaharaPoints      Int
  bendaharaTopsis      Float           @default(0)
  memberScoresJson     String          @default("[]")
  totalBordaPoints     Int
  finalRank            Int
  statusRecommendation String
  consensus            ConsensusRecord @relation(fields: [consensusId], references: [id], onDelete: Cascade)
  proker               ProgramKerja    @relation(fields: [prokerId], references: [id], onDelete: Cascade)

  @@unique([consensusId, prokerId])
}
